{
    "name": "fredrik/debtlens",
    "description": "PHP technical debt analyse verktøy",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Fredrik\\DebtLens\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Fredrik Bjørgan"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "nikic/php-parser": "^5.9"
    },
    "require-dev": {
        "pestphp/pest": "^5.2"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
